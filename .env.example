# Secreto para firmar las sesiones (obligatorio en produccion). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=
# URL publica usada en los enlaces de los correos
APP_URL=http://localhost:3000

# Supabase (Project Settings > API en supabase.com). SUPABASE_SERVICE_ROLE_KEY
# es secreta: solo se usa en el servidor, nunca la pongas en variables NEXT_PUBLIC_*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: envio real de correos con Resend (https://resend.com).
# Sin RESEND_API_KEY, los correos se imprimen en la consola del servidor.
RESEND_API_KEY=
EMAIL_FROM=OdontoLink <no-reply@tudominio.com>
